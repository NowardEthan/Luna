# Perfil: CLOUD — agente IDE via Groq (chat usa luna-core/.env cloud-groq)
# Aplicar: npm run luna-env:cloud

LLM_PRIMARY=groq
LLM_CLOUD_ENABLED=1
LLM_FALLBACK_ENABLED=0

GROQ_API_KEY=COLOCA_TUA_GROQ_KEY_AQUI
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_EMBED_MODEL=nomic-embed-text-v1_5
GROQ_TEMPERATURE=0.6
GROQ_CHAT_TIMEOUT_MS=180000
GROQ_REASONING_ENABLED=1
GROQ_REASONING_EFFORT=medium
