# Variáveis para o serviço Luna API no Railway (copiar para Variables no painel).
# Root Directory do projeto: backend
# Domínio: Settings → Networking → Generate Domain (ou custom domain)

LUNA_DEPLOY_MODE=railway

# ── Asaas (produção no lançamento; sandbox até lá) ───────────────────────
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_ALLOW_OPEN=0

# Webhook URL no painel Asaas (depois do deploy):
# https://SEU-SERVICO.up.railway.app/v1/billing/webhook/asaas

# ── Firebase Admin (webhook + checkout escrevem Firestore) ───────────────
# Opção A (Railway): colar JSON inteiro numa linha
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opção B (local): ficheiro — não usar no Railway
# FIREBASE_SERVICE_ACCOUNT_PATH=chaves/....json

# ── LLM cloud no servidor (opcional — app desktop pode usar Core local) ─
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── App Electron (build de produção — .env local, não no Railway) ───────
# LUNA_SERVER_URL=https://SEU-SERVICO.up.railway.app
# LUNA_USE_SERVER=1
