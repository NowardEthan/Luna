{
  "name": "orbit-legacy",
  "private": true,
  "version": "0.1.0-legacy",
  "description": "LEGACY — host visual Luna congelado (jun/2026). Sucessor: Luna Runtime em Projects/Luna.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,vite,electron -c magenta,cyan,green \"node scripts/start-server-if-needed.cjs\" \"vite\" \"node scripts/launch-electron-dev.cjs\"",
    "dev:electron": "node scripts/launch-electron-dev.cjs",
    "dev:web": "vite",
    "server": "backend\\.venv\\Scripts\\python.exe backend/run_server.py",
    "server:install": "node scripts/install-python-server.cjs",
    "server:watch": "backend\\.venv\\Scripts\\python.exe backend/run_server.py",
    "server:kill": "powershell -NoProfile -Command \"$p=(Get-NetTCPConnection -LocalPort 39281 -ErrorAction SilentlyContinue).OwningProcess|Select-Object -First 1; if($p){Stop-Process -Id $p -Force; Write-Host 'Servidor na porta 39281 encerrado (PID' $p ')'} else {Write-Host 'Nenhum processo na porta 39281'}\"",
    "build": "tsc -b && vite build",
    "electron:run": "npm run build && electron .",
    "pack:prepare": "node scripts/prepare-electron-pack.cjs",
    "dist:win": "vite build && npm run pack:prepare && electron-builder --win portable --config electron-builder.yml",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run build && npm test",
    "preview": "vite preview",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,storage",
    "firebase:list-storage": "node scripts/list-marketplace-storage.cjs",
    "firebase:write-init": "node scripts/write-firebase-hosting-init.cjs",
    "firebase:deploy-catalog": "npm run firebase:write-init && node scripts/write-marketplace-catalog.cjs && firebase deploy --only hosting",
    "addon:pack-ide": "node scripts/pack-luna-ide-addon.cjs",
    "addon:install-ide-dev": "node scripts/install-luna-ide-addon-dev.cjs",
    "addon:install-finances-dev": "node scripts/install-luna-finances-dev.cjs",
    "addon:upload-ide": "node scripts/upload-luna-ide-addon.cjs",
    "addon:publish-ide": "npm run addon:pack-ide && npm run addon:upload-ide && node scripts/write-marketplace-catalog.cjs",
    "firebase:deploy": "npm run firebase:write-init && firebase deploy --only firestore:rules,storage,hosting",
    "firebase:sync-env": "node scripts/sync-firebase-env.cjs",
    "i18n:check": "node scripts/check-i18n-keys.cjs",
    "i18n:scan": "node scripts/find-hardcoded-ui.cjs",
    "luna-core:build": "npm run build --prefix \"../core/src/luna-core\"",
    "luna-core:check": "node scripts/check-luna-core-bridge.cjs",
    "luna-core:check:electron": "electron scripts/check-luna-core-electron.cjs",
    "luna-core:check:recall": "node scripts/check-luna-core-recall.cjs",
    "luna-core:rebuild-electron": "npx electron-rebuild -f -w better-sqlite3 --module-dir \"../core/src/luna-core\"",
    "luna-env:local": "node scripts/apply-luna-env-profile.cjs local",
    "luna-env:cloud": "node scripts/apply-luna-env-profile.cjs cloud-groq"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.4.2",
    "firebase": "^11.10.0",
    "i18next": "^26.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "translate": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  }
}
