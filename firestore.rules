rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Igual ao projeto Luna (luna-8787d): dono autenticado, sem gate extra no token.
    function billingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'billing', 'entitlements']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.plan == 'free';
      allow update: if isOwner(userId) && billingFieldsUnchanged();
      allow delete: if isOwner(userId);

      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }

        match /messages_trash/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /collections/{collectionId} {
        allow read, write: if isOwner(userId);
      }

      match /conversations_trash/{conversationId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /memoryNotes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Metering cloud (P2 leitura · P3 incremento pelo cliente autenticado)
      match /usage/{monthKey} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.turns is int
          && request.resource.data.turns >= 1
          && request.resource.data.turns <= 100000;
        allow update: if isOwner(userId)
          && request.resource.data.turns is int
          && resource.data.turns is int
          && request.resource.data.turns == resource.data.turns + 1
          && request.resource.data.turns <= 100000;
      }

      match /pluginInstalls/{pluginId} {
        allow read, write: if isOwner(userId);
      }

      match /marketplacePublications/{pluginId} {
        allow read, write: if isOwner(userId);
      }

      match /financeAccounts/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeCategories/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeTransactions/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeBudgets/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeGoals/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeRecurring/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeBills/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeCreditCards/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financePiggyBanks/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financePiggyBankTx/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeTags/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeNotifications/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /financeMeta/{docId} {
        allow read, write: if isOwner(userId);
      }

      // OrbitLab Finanças (spec FINANCAS-CONCEPT) — coleções novas em pt-BR.
      // Sem isto o catch-all bloqueia e o app cria/lê em silêncio falho (mesmo muro
      // que já pegamos com routine/documentos).
      match /carteiras/{carteiraId} {
        allow read, write: if isOwner(userId);
      }
      match /lancamentos/{lancamentoId} {
        allow read, write: if isOwner(userId);
      }
      match /recorrentes/{recorrenteId} {
        allow read, write: if isOwner(userId);
      }
      match /transferencias/{transferenciaId} {
        allow read, write: if isOwner(userId);
      }
      match /metasFinanceiras/{metaId} {
        allow read, write: if isOwner(userId);
      }

      // BYOK — metadados (chaves API ficam no cofre local Electron)
      match /byok/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Canvas da Luna/OrbitLab: workspaces privados do usuario.
      match /workspaces/{workspaceId} {
        allow read, write: if isOwner(userId);

        match /elementos/{elementoId} {
          allow read, write: if isOwner(userId);
        }

        match /versoes/{versaoId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /rosary_days/{dateKey} {
        allow read, write: if isOwner(userId);
      }

      // A Rotina — os blocos do dia. O SERVIDOR escreve com o admin SDK (passa por cima
      // destas regras), mas o APP lê com as regras normais. Sem esta linha, a Luna criava o
      // bloco, dizia «criei» (verdade), e o ecrã dele aparecia VAZIO — porque a leitura era
      // negada e o erro era engolido em silêncio.
      //
      // Aconteceu em campo, no primeiro teste. A ferramenta funcionava, a Luna era honesta,
      // e mesmo assim ele viu uma mentira — porque a permissão de LEITURA não existia.
      match /routine/{blockId} {
        allow read, write: if isOwner(userId);
      }

      // O registo do dia (feito / hoje_nao / ignorado) — é o que a faz reparar que ele sumiu.
      match /routine_log/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // As rotinas alternativas (Férias, Semana de provas…). Sem esta regra, o app criava a
      // rotina mas não a conseguia LER — o mesmo muro invisível que já apanhámos com os blocos.
      match /routine_sets/{setId} {
        allow read, write: if isOwner(userId);
      }

      // O riscado de HOJE dentro de cada bloco (passos/subtarefas por-dia). Doc à parte do
      // routine_log de propósito — assim um item riscado nunca é lido pelo core como «ignorado».
      match /routine_items/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // O estado do jogo da rotina — a luz acumulada e a ofensiva. Concluir dá luz.
      match /gamestate/{docId} {
        allow read, write: if isOwner(userId);
      }

      // A Caixa de Entrada (Ideias) — pensamentos soltos que a Luna guarda (com admin) e o app
      // lê/arquiva. Sem esta regra, o app não LÊ as ideias (o mesmo muro invisível dos blocos).
      match /ideias/{ideiaId} {
        allow read, write: if isOwner(userId);
      }

      // A Estante de Documentos — a Luna cria com o admin SDK (`criar_documento`) e o app LÊ
      // (cartão no chat + leitor + editor). O MESMO muro invisível dos blocos: sem esta regra o
      // servidor gravava o documento, a Luna dizia «criei» (verdade), e o cartão nunca aparecia —
      // porque a leitura do cliente era negada pelo catch-all e o erro morria em silêncio.
      match /documentos/{documentoId} {
        allow read, write: if isOwner(userId);

        // O histórico de versões do artefato — cada reescrita (pela Luna com admin, ou pelo
        // Ethan no app) guarda aqui um retrato do estado anterior. Regra à parte de propósito:
        // no Firestore a regra do documento NÃO cai em cascata na subcoleção, então sem isto
        // o app lê o artefato mas o «Histórico» viria vazio (leitura negada em silêncio).
        match /versoes/{versaoId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /marketplaceCatalog/listings/{listingId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // ── Chamados ("Fala com o Ethan") ─────────────────────────────────────────
    // Canal de suporte de MÃO DUPLA: o usuário abre um chamado, o Ethan (admin) lê
    // a caixa de entrada e responde. Coleção de TOPO (não vive sob users/{uid}) de
    // propósito — o admin precisa varrer todos os chamados de uma vez.
    //
    // O uid do Ethan é o mesmo do app (ChamadosRepository.ETHAN_UID) e o mesmo
    // UID_CRIADOR_CANONICO do core. Sem estas regras o catch-all abaixo bloqueia e
    // o chamado nasce, a Luna/app grava, e a tela aparece vazia (o mesmo muro
    // invisível que já pegamos com routine/documentos).
    function ehEthanChamados() {
      return signedIn()
        && request.auth.uid == 'aKp1czWVMqWQdJ9nAIcIKgxKNu92';
    }

    match /chamados/{chamadoId} {
      // Ler: só o dono do chamado (uid do doc) ou o Ethan. O vizinho não enxerga.
      allow read: if (signedIn() && request.auth.uid == resource.data.uid)
        || ehEthanChamados();

      // Criar: qualquer logado, mas o doc TEM que sair com o uid dele — não dá pra
      // abrir chamado em nome de outro.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      // Atualizar: dono (marcar lido, mandar mensagem) ou Ethan (status/responder).
      allow update: if (signedIn() && request.auth.uid == resource.data.uid)
        || ehEthanChamados();

      allow delete: if false;

      // A conversa do chamado. A regra do pai NÃO cai em cascata na subcoleção, por
      // isso o get() aqui: só quem é dono do chamado-pai (ou o Ethan) entra. As
      // mensagens são imutáveis — ninguém edita o que já foi dito.
      match /mensagens/{mensagemId} {
        function donoDoPai() {
          return signedIn()
            && get(/databases/$(database)/documents/chamados/$(chamadoId)).data.uid
               == request.auth.uid;
        }
        allow read, create: if donoDoPai() || ehEthanChamados();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
