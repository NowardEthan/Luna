# Servidor Luna (logs no terminal) — npm run server | porta em dev
LUNA_SERVER_PORT=39281
LUNA_SERVER_HOST=127.0.0.1
# Electron usa HTTP em vez de IPC pesado (1=ligado em npm run dev)
LUNA_USE_SERVER=1
# Pasta de dados (SQLite RAG + memória) — opcional
# LUNA_DATA_DIR=C:\Users\you\AppData\Luna\userData

# Provedor principal: groq | together | ollama | openrouter
LLM_PRIMARY=groq
# Dev — Ollama (API OpenAI em http://127.0.0.1:11434/v1)
# LLM_PRIMARY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_TEMPERATURE=0.6
# OLLAMA_CHAT_TIMEOUT_MS=300000
#
# Modelo local (grátis, sem :cloud) — Qwen3.5 tem tools + visão + thinking
# ollama pull qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Mais rápido no Qwen3.5: reasoning_effort none (Luna já usa quando Pensamento está off)
# OLLAMA_REASONING_EFFORT=none
# OLLAMA_REASONING_EFFORT_ON=low
#
# ~12 GB RAM livre: use qwen3.5:9b (≈6.6 GB). Evite :27b/:32b (pedem ~17 GB).
# Mais leve: qwen3.5:4b
#
# Kimi K2.6 — só :cloud (pago/limites Ollama; NÃO usa a tua GPU)
# OLLAMA_MODEL=kimi-k2.6:cloud
# OLLAMA_CLOUD_TIMEOUT_MS=600000
# Se o principal falhar (créditos, quota, erro API), tenta o outro
LLM_FALLBACK_ENABLED=1
# Testes só locais: LLM_PRIMARY=ollama + LLM_CLOUD_ENABLED=0 + LLM_FALLBACK_ENABLED=0
# LLM_CLOUD_ENABLED=0
# LLM_STREAMING_ENABLED=1

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/cobuddy:free
# Lunar Vision (multimodal) — OpenRouter em primeiro na cadeia
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.6
OPENROUTER_CHAT_TIMEOUT_MS=180000
# Memória semântica (embeddings) — usa a mesma chave OpenRouter
OPENROUTER_EMBED_MODEL=thenlper/gte-base
# Ordem alternativa: LLM_EMBED_ORDER=openrouter,groq,together,ollama
# Ollama local só para embed se o modelo existir: ollama pull nomic-embed-text
#
# Catálogo do selector no chat (provider|model_id|rótulo). Várias entradas com | entre si.
# Se vazio, entradas automáticas a partir das chaves *_API_KEY + *_MODEL no .env.
# LUNA_MODELS=openrouter|baidu/cobuddy:free|CoBuddy (free)|openrouter|inclusionai/ring-2.6-1t:free|Ring 2.6 (free)|ollama|qwen3.5:9b|Ollama local
# Pensamento visível (OpenRouter): effort opcional — low|medium|high|xhigh|minimal|none
# OPENROUTER_REASONING_EFFORT=medium
# Com Pensamento desligado: Ring/CoBuddy usam reasoning interno mas exclude:true (resposta normal)
# OPENROUTER_REASONING_EFFORT_OFF=low
# Modelos com thinking nativo extra (além de ring, deepseek-r1, …)
# OPENROUTER_NATIVE_REASONING_MODELS=ring,inclusionai/ring
# Tradução do bloco «Pensamento» (motor dedicado, sem LLM de chat)
# TRANSLATE_ENGINE=google
# TRANSLATE_ENGINE=deepl
# DEEPL_API_KEY=
# TRANSLATE_ENGINE=libre
# LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=
# Idioma da UI / tradução automática: localStorage luna-ui-locale, luna-auto-translate
# (migra automaticamente de luna-reasoning-display-lang / luna-reasoning-translate)

# Together AI — https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=deepseek-ai/DeepSeek-V4-Pro
TOGETHER_VISION_MODEL=meta-llama/Llama-Vision-Free
TOGETHER_EMBED_MODEL=intfloat/multilingual-e5-large-instruct
TOGETHER_TEMPERATURE=1.0
TOGETHER_CHAT_TIMEOUT_MS=180000
TOGETHER_REASONING_ENABLED=0

# Groq (principal recomendado) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Groq pode não expor embeddings — OpenRouter acima é o fallback recomendado
# GROQ_EMBED_MODEL=nomic-embed-text-v1_5
GROQ_TEMPERATURE=0.6
GROQ_CHAT_TIMEOUT_MS=180000
# Reasoning gpt-oss (agente): 1 para expor pensamento no badge
GROQ_REASONING_ENABLED=1
GROQ_REASONING_EFFORT=medium
# Alias global (opcional)
LLM_REASONING_ENABLED=1

# Pesquisa web (ferramenta web_search do agente)
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily
# Janela de recência Tavily (dias, 1–365; default 30)
TAVILY_SEARCH_DAYS=30

# Memória automática após cada turno (se o modelo não chamou save_memory)
# localStorage luna-auto-memory-capture (1=ligado por defeito, 0=desligado)

# Modo IDE — contexto injectado (chars; também em localStorage luna-ide-*)
# LUNA_IDE_CONTEXT_MAX_CHARS=18000
# LUNA_IDE_ACTIVE_FILE_MAX_CHARS=12000
# LUNA_IDE_TERMINAL_TAIL_LINES=40
# LUNA_IDE_GIT_DIFF_MAX_CHARS=6000
# Indexar workspace ao abrir pasta: localStorage luna-ide-index-auto (1=sim, 0=não)
# Aplicar patches sem confirmação: localStorage luna-ide-auto-apply (1=sim)
# Orquestrador IDE (continuidade estilo Cursor) — rondas LLM e tool calls por turno
# VITE_LUNA_IDE_MAX_LLM_ROUNDS=25
# VITE_LUNA_IDE_MAX_TOOL_CALLS=60

# Opcional — RAG
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=4500
RAG_EMBED_BATCH=32
