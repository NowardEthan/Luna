# ── Luna — copie para .env e preencha as chaves ─────────────────────────
# Perfis rápidos: npm run luna-env:local  |  npm run luna-env:cloud
# Guia: docs/configuracao-ambiente-luna.md

# Caminho para o pacote luna-core (import nativo via dist/entry-desktop.js)
LUNA_CORE_PATH=C:\Users\ethan\Documents\Core\Luna\src\luna-core
# Antes do primeiro uso: npm run luna-core:build (no Orbit)
# Memória SQLite no Electron: npm run luna-core:rebuild-electron (opcional)

# Servidor Luna (npm run dev / npm run server)
LUNA_SERVER_PORT=39281
LUNA_SERVER_HOST=127.0.0.1
# Produção (Railway): URL HTTPS — substitui host:port local
# LUNA_SERVER_URL=https://luna-api-production.up.railway.app
LUNA_USE_SERVER=1

# LLM — LM Studio local (agente IDE; chat usa luna-core/.env)
# LM Studio: Local Server em http://127.0.0.1:1234/v1
LLM_PRIMARY=ollama
LLM_CLOUD_ENABLED=0
LLM_FALLBACK_ENABLED=0
LLM_STREAMING_ENABLED=1

OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:1234/v1
OLLAMA_MODEL=qwen/qwen2.5-vl-7b
OLLAMA_CHAT_TIMEOUT_MS=300000

# LLM — Groq (nuvem) — descomenta para voltar à nuvem no IDE
# LLM_PRIMARY=groq
# LLM_CLOUD_ENABLED=1
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_EMBED_MODEL=nomic-embed-text-v1_5
GROQ_TEMPERATURE=0.6
GROQ_CHAT_TIMEOUT_MS=180000
GROQ_REASONING_ENABLED=1
GROQ_REASONING_EFFORT=medium

# RAG
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=4500
RAG_EMBED_BATCH=32

# Tradução do raciocínio
TRANSLATE_ENGINE=google
GOOGLE_TRANSLATE_API_KEY=

# Pesquisa web
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily
TAVILY_SEARCH_DAYS=30

# Modo IDE
VITE_LUNA_IDE_MAX_LLM_ROUNDS=25
VITE_LUNA_IDE_MAX_TOOL_CALLS=60

# ── Firebase (opcional) ───────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_LUNA_CLOUD_ANON=1
VITE_LUNA_CLOUD_SYNC=0
VITE_FIREBASE_USE_EMULATORS=0

# ── Opcional: OpenRouter como fallback / embed ─────────────────────────────
# LLM_FALLBACK_ENABLED=1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=poolside/laguna-m.1:free

# ── Asaas (pagamentos — PIX, boleto, cartão) ──────────────────────────────
# API (backend P4): https://www.asaas.com/apiKeys
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token opcional para validar webhooks (P4)
ASAAS_WEBHOOK_TOKEN=
# Só dev local sem token no painel Asaas (não usar em produção)
ASAAS_WEBHOOK_ALLOW_OPEN=0
# Railway: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...} (uma linha)
# Deploy: docs/deploy-railway.md · template env.profiles/railway.env.example

# Links de checkout (UI Planos) — Asaas → Cobranças → Link de pagamento
# Cola o URL completo de cada plano/período:
VITE_ASAAS_LINK_PLUS_MONTHLY=
VITE_ASAAS_LINK_PLUS_ANNUAL=
VITE_ASAAS_LINK_PRO_MONTHLY=
VITE_ASAAS_LINK_PRO_ANNUAL=
VITE_ASAAS_LINK_BYOK_MONTHLY=
VITE_ASAAS_LINK_BYOK_ANNUAL=
