rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pacotes de plugins publicados (leitura pública; escrita só via Admin SDK / CI)
    match /marketplace/plugins/{pluginId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Uploads privados por utilizador
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
